<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#f7f5ff">
<title>ポケツイ交換レート計算</title>
<style>
:root{
  --bg:#f7f5ff; --card:#fff; --text:#302d3d; --muted:#777285;
  --line:#e8e3f0; --accent:#7b61d9; --accent2:#eee9ff;
  --good:#2f8f67; --mid:#8b6b21; --warn:#bd7048; --bad:#bd4d5b;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",sans-serif}
button,select{font:inherit}
header{padding:24px 18px 16px;text-align:center}
h1{font-size:22px;margin:0 0 6px}
header p{margin:0;color:var(--muted);font-size:13px}
main{max-width:620px;margin:auto;padding:0 14px 40px}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:16px;margin:12px 0;box-shadow:0 4px 14px #3d31500a}
.hidden{display:none}.card h2{font-size:17px;margin:0 0 14px}
label.title{display:block;font-weight:700;font-size:13px;margin:12px 0 7px}
select{width:100%;padding:12px;border:1px solid var(--line);border-radius:12px;background:#fff;color:var(--text)}
.checks{display:grid;gap:8px}
.check{display:flex;align-items:center;gap:9px;padding:10px 11px;border:1px solid var(--line);border-radius:12px;font-size:13px}
.check input{width:18px;height:18px;accent-color:var(--accent)}
.calc{margin-top:14px;padding:12px;border-radius:12px;background:var(--accent2);font-size:13px}
.calc strong{font-size:20px}
.add{width:100%;border:0;border-radius:12px;padding:12px;margin-top:12px;background:var(--accent);color:white;font-weight:700}
.items{display:grid;gap:8px;margin-top:12px}
.item{border:1px solid var(--line);border-radius:13px;padding:11px;font-size:13px;display:flex;justify-content:space-between;gap:10px}
.item small{display:block;color:var(--muted);margin-top:3px}
.item .right{text-align:right;white-space:nowrap}
.del{border:0;background:none;color:#b85a67;font-size:12px;padding:4px 0}
.total{display:flex;justify-content:space-between;margin-top:12px;padding-top:12px;border-top:1px solid var(--line);font-weight:700}
.result{text-align:center;padding:20px 12px}
.result .numbers{display:flex;justify-content:center;gap:28px;margin:8px 0 14px}
.num span{display:block;color:var(--muted);font-size:12px}.num b{font-size:26px}
.diff{font-size:30px;font-weight:800}
.badge{display:inline-block;margin-top:7px;padding:7px 13px;border-radius:999px;font-weight:700;font-size:13px}
.good{background:#e3f4ec;color:var(--good)} .mid{background:#f7efd6;color:var(--mid)}
.warn{background:#f8e9df;color:var(--warn)} .bad{background:#fae4e7;color:var(--bad)}
.note{font-size:11px;color:var(--muted);line-height:1.55;margin-top:10px}
.reset{width:100%;padding:10px;border:1px solid var(--line);border-radius:12px;background:white;color:var(--muted);margin-top:10px}
footer{text-align:center;color:var(--muted);font-size:11px;padding:4px 0 20px}
</style>
</head>
<body>
<header>
  <h1>ポケツイ交換レート計算</h1>
  <p>条件を選んでアイテムを追加するだけ ✨</p>
</header>
<main>
<section class="card">
  <h2>譲るもの</h2>
  <div class="items" id="giveItems"></div>
  <div class="total"><span>譲るもの合計</span><span id="giveTotal">0</span></div>
  <button class="add" id="giveOpen" onclick="toggleForm('give')">＋ アイテムを追加</button>
  <div id="giveForm" class="hidden"></div>
</section>

<section class="card">
  <h2>求めるもの</h2>
  <div class="items" id="wantItems"></div>
  <div class="total"><span>求めるもの合計</span><span id="wantTotal">0</span></div>
  <button class="add" id="wantOpen" onclick="toggleForm('want')">＋ アイテムを追加</button>
  <div id="wantForm" class="hidden"></div>
</section>

<section class="card result">
  <h2>交換結果</h2>
  <div class="numbers">
    <div class="num"><span>譲る</span><b id="gNum">0</b></div>
    <div class="num"><span>求める</span><b id="wNum">0</b></div>
  </div>
  <div class="diff" id="diff">＋0</div>
  <div id="judge" class="badge mid">丁度いいレート</div>
  <div class="note">差 ＝ 求めるもののレート − 譲るもののレート<br>＋の数字が大きいほど、あなたにとって好条件です。</div>
  <button class="reset" onclick="resetAll()">全部リセット</button>
</section>
<footer>レプリカは、すべての加算後に最終レートを1/2にします。</footer>
</main>

<script>
const base = {
  "現行N":1, "現行R":2, "現行SR":4,
  "過去N":2, "過去R":4, "過去SR":8
};
const sales = {
  "通常ガチャ":0, "イベント品":0, "福袋":1,
  "Choice Bag（CB）":1, "招待ガチャ":1,
  "ドリフェス（DF）":2, "課金のおまけ品":2
};
const extras = [
  ["人気品（ほしい1万超え）",1],
  ["年代物（23年以前のアイテム）",1],
  ["香水・エクステ・ケモ耳など",1]
];
let lists = {give:[], want:[]};

function formHTML(side){
  const id=side+"Type";
  return `
    <label class="title">アイテムの種類</label>
    <select id="${id}">
      ${Object.keys(base).map(x=>`<option>${x}</option>`).join("")}
    </select>
    <label class="title">販売形態</label>
    <select id="${side}Sale">
      ${Object.keys(sales).map(x=>`<option>${x}</option>`).join("")}
    </select>
    <label class="title">追加条件</label>
    <div class="checks">
      ${extras.map((x,i)=>`<label class="check"><input type="checkbox" id="${side}Ex${i}"> ${x[0]} <span style="margin-left:auto;color:#777">＋${x[1]}</span></label>`).join("")}
      <label class="check"><input type="checkbox" id="${side}Replica"> レプリカ <span style="margin-left:auto;color:#777">最後に÷2</span></label>
    </div>
    <div class="calc">現在のアイテム：<strong id="${side}Preview">1</strong> 点</div>
    <button class="add" onclick="addItem('${side}')">＋ このアイテムを追加</button>
  `;
}
document.getElementById("giveForm").innerHTML=formHTML("give");
document.getElementById("wantForm").innerHTML=formHTML("want");
function toggleForm(side){
  const f=document.getElementById(side+"Form");
  const b=document.getElementById(side+"Open");
  const opening=f.classList.contains("hidden");
  f.classList.toggle("hidden");
  b.textContent=opening ? "− アイテム追加を閉じる" : "＋ アイテムを追加";
}

function calc(side){
  const type=document.getElementById(side+"Type").value;
  const sale=document.getElementById(side+"Sale").value;
  const A=base[type];
  let total=A;
  let steps=[`${type}：${A}`];
  const s=sales[sale];
  if(s){ total += A*s; steps.push(`${sale}：＋${A*s}`); }
  extras.forEach((x,i)=>{
    if(document.getElementById(side+"Ex"+i).checked){
      total += A*x[1]; steps.push(`${x[0]}：＋${A*x[1]}`);
    }
  });
  if(document.getElementById(side+"Replica").checked){
    total/=2; steps.push(`レプリカ：÷2`);
  }
  document.getElementById(side+"Preview").textContent=fmt(total);
  return {total,steps};
}
function fmt(n){return Number.isInteger(n)?n:n.toFixed(1).replace(/\.0$/,"")}
function addItem(side){
  const c=calc(side);
  const type=document.getElementById(side+"Type").value;
  const sale=document.getElementById(side+"Sale").value;
  const tags=extras.filter((x,i)=>document.getElementById(side+"Ex"+i).checked).map(x=>x[0]);
  if(document.getElementById(side+"Replica").checked) tags.push("レプリカ");
  lists[side].push({type,sale,tags,total:c.total,steps:c.steps});
  render(side);
  // reset conditions but keep convenient default type
  document.getElementById(side+"Sale").selectedIndex=0;
  extras.forEach((x,i)=>document.getElementById(side+"Ex"+i).checked=false);
  document.getElementById(side+"Replica").checked=false;
  calc(side);
  document.getElementById(side+"Form").classList.add("hidden");
  document.getElementById(side+"Open").textContent="＋ アイテムを追加";
}
function render(side){
  const el=document.getElementById(side+"Items");
  const arr=lists[side];
  el.innerHTML=arr.map((it,i)=>`
    <div class="item">
      <div><b>${it.type}</b><small>${it.sale}${it.tags.length?" ・ "+it.tags.join(" ・ "):""}</small>
      <small>${it.steps.join(" → ")}</small></div>
      <div class="right"><b>${fmt(it.total)}点</b><br><button class="del" onclick="removeItem('${side}',${i})">削除</button></div>
    </div>`).join("");
  const total=arr.reduce((a,b)=>a+b.total,0);
  document.getElementById(side+"Total").textContent=fmt(total);
  document.getElementById(side==="give"?"gNum":"wNum").textContent=fmt(total);
  updateResult();
}
function removeItem(side,i){lists[side].splice(i,1);render(side)}
function updateResult(){
  const g=lists.give.reduce((a,b)=>a+b.total,0);
  const w=lists.want.reduce((a,b)=>a+b.total,0);
  const d=w-g;
  document.getElementById("diff").textContent=(d>=0?"＋":"")+fmt(d);
  const j=document.getElementById("judge");
  if(d>=3){j.textContent="好条件寄り";j.className="badge good"}
  else if(d>=0){j.textContent="丁度いいレート";j.className="badge mid"}
  else if(d===-1){j.textContent="若干損だけどアリかも";j.className="badge warn"}
  else{j.textContent="オススメはしない";j.className="badge bad"}
}
["give","want"].forEach(side=>{
  document.getElementById(side+"Type").addEventListener("change",()=>calc(side));
  document.getElementById(side+"Sale").addEventListener("change",()=>calc(side));
  extras.forEach((x,i)=>document.getElementById(side+"Ex"+i).addEventListener("change",()=>calc(side)));
  document.getElementById(side+"Replica").addEventListener("change",()=>calc(side));
  calc(side);
});
function resetAll(){
  lists={give:[],want:[]};
  render("give");render("want");
  ["give","want"].forEach(side=>{
    document.getElementById(side+"Type").selectedIndex=0;
    document.getElementById(side+"Sale").selectedIndex=0;
    extras.forEach((x,i)=>document.getElementById(side+"Ex"+i).checked=false);
    document.getElementById(side+"Replica").checked=false;
    calc(side);
  });
}
</script>
</body>
</html>
